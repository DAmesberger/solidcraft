  {
   "command": "appearance.graph.create",
   "params": {
    "id": "brushed-aluminium",
    "name": "Brushed aluminium",
    "graph": {
     "name": "Brushed aluminium",
     "nodes": [
      {
       "id": "uv",
       "kind": "texcoord.planar",
       "params": {
        "space": "object"
       },
       "inputs": {
        "origin": [
         0,
         0,
         0
        ],
        "u": [
         1,
         0,
         0
        ],
        "v": [
         0,
         1,
         0
        ]
       }
      },
      {
       "id": "lines",
       "kind": "pattern.brushed",
       "inputs": {
        "texcoord": {
         "from": "uv"
        },
        "density_per_mm": 40,
        "streak_mm": 6,
        "contrast": 0.55,
        "jitter": 0.3,
        "seed": 5
       }
      },
      {
       "id": "rough",
       "kind": "remap",
       "inputs": {
        "in": {
         "from": "lines"
        },
        "out_min": 0.22,
        "out_max": 0.3
       }
      },
      {
       "id": "tint",
       "kind": "remap",
       "inputs": {
        "in": {
         "from": "lines"
        },
        "out_min": 0.96,
        "out_max": 1.03
       }
      },
      {
       "id": "base",
       "kind": "multiply",
       "inputs": {
        "a": [
         0.91,
         0.92,
         0.92
        ],
        "b": {
         "from": "tint"
        }
       }
      },
      {
       "id": "surface",
       "kind": "standard_surface",
       "inputs": {
        "base_color": {
         "from": "base",
         "fallback": [
          0.91,
          0.92,
          0.92
         ]
        },
        "base_metalness": 1,
        "specular_roughness": {
         "from": "rough",
         "fallback": 0.26
        },
        "specular_roughness_anisotropy": 0.7,
        "geometry_tangent": {
         "from": "lines.tangent"
        }
       }
      }
     ],
     "output": "surface"
    }
   }
  },
