        },
        "pitch_mm": [
         2.0,
         2.0
        ],
        "crown": 1,
        "fibres": 9,
        "fibre_contrast": 0.35
       }
      },
      {
       "id": "albedo",
       "kind": "remap",
       "inputs": {
        "in": {
         "from": "weave"
        },
        "out_min": 0.018,
        "out_max": 0.075
       }
      },
      {
       "id": "rough",
       "kind": "remap",
       "inputs": {
        "in": {
         "from": "weave"
        },
        "out_min": 0.42,
        "out_max": 0.28
       }
      },
      {
       "id": "bump",
       "kind": "normal.from_height",
       "inputs": {
        "height": {
         "from": "weave"
        },
        "relief_mm": 0.02
       }
      },
      {
       "id": "carbon",
       "kind": "standard_surface",
       "inputs": {
        "base_color": {
         "from": "albedo",
         "fallback": [
          0.035,
          0.035,
          0.038
         ]
        },
        "specular_roughness": {
         "from": "rough",
         "fallback": 0.35
        },
        "specular_ior": 1,
        "geometry_normal": {
         "from": "bump"
        },
        "coat_weight": 1,
        "coat_roughness": 0.05,
        "coat_ior": 1.5
       }
      },
      {
       "id": "frame",
       "kind": "texcoord.planar",
       "params": {
        "space": "object"
       },
       "inputs": {
        "origin": [
         95,
         65,
         0
        ],
        "u": [
         60,
         0,
         0
        ],
        "v": [
         0,
         -30,
         0
        ]
       }
      },
      {
       "id": "print",
       "kind": "image",
       "params": {
        "space": "srgb",
        "wrap": "clamp",
        "channel": "a"
       },
       "inputs": {
        "texcoord": {
         "from": "frame"
        },
        "file": {
         "interface": "label"
        }
       }
      },
      {
       "id": "paper",
       "kind": "standard_surface",
       "inputs": {
        "base_color": {
         "from": "print.color",
         "fallback": [
          0.95,
          0.93,
          0.89
         ]
        },
        "specular_roughness": 0.5,
        "specular_ior": 1.5
       }
      },
      {
       "id": "surface",
       "kind": "surface.mix",
       "inputs": {
        "fg": {
         "from": "paper"
        },
        "bg": {
         "from": "carbon"
        },
        "mix": {
         "from": "print.alpha",
         "fallback": 0
        }
       }
      }
     ],
     "output": "surface"
    }
   }
