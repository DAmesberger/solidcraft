{
 "name": "Brushed nickel silver",
 "nodes": [
  {
   "id": "uv",
   "kind": "texcoord.planar",
   "params": {
    "space": "object"
   },
   "inputs": {
    "origin": [
     0,
     0,
     0
    ],
    "u": [
     1,
     0,
     0
    ],
    "v": [
     0,
     1,
     0
    ]
   }
  },
  {
   "id": "lines",
   "kind": "pattern.brushed",
   "inputs": {
    "texcoord": {
     "from": "uv"
    },
    "density_per_mm": 40,
    "streak_mm": 4,
    "contrast": 0.6,
    "jitter": 0.3,
    "seed": 7
   }
  },
  {
   "id": "rough",
   "kind": "remap",
   "inputs": {
    "in": {
     "from": "lines"
    },
    "out_min": 0.25,
    "out_max": 0.31
   }
  },
  {
   "id": "tint",
   "kind": "remap",
   "inputs": {
    "in": {
     "from": "lines"
    },
    "out_min": 0.97,
    "out_max": 1.03
   }
  },
  {
   "id": "base",
   "kind": "multiply",
   "inputs": {
    "a": [
     0.8,
     0.77,
     0.7
    ],
    "b": {
     "from": "tint"
    }
   }
  },
  {
   "id": "surface",
   "kind": "standard_surface",
   "inputs": {
    "base_color": {
     "from": "base"
    },
    "base_metalness": 1,
    "specular_roughness": {
     "from": "rough"
    },
    "specular_roughness_anisotropy": 0.6,
    "geometry_tangent": {
     "from": "lines.tangent"
    }
   }
  }
 ],
 "output": "surface"
}
